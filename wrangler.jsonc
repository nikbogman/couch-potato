{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "couch-potato",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // Secret (not here): TMDB_API_KEY. Locally it comes from .dev.vars. Accounts live in D1 (scripts/owner.ts makes yours).
  "build": { "command": "bun run build", "watch_dir": "ui" },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // The Worker checks the session before serving anything, the app shell and bundles included.
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "couch-potato", "database_id": "f9fb0e21-a8e2-4aae-a565-db44f0f85947", "migrations_dir": "migrations" }],
  // Sign-in, pairing and invite attempts per IP.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "Relay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
}
