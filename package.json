{
  "name": "couch-potato",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ui/index.html --outdir dist --minify --public-path / --asset-naming [name].[ext]",
    "dev": "wrangler dev --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.158.0"
  }
}
